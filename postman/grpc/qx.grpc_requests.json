{
  "service": "qx.v1.Broker",
  "package": "qx.v1",
  "proto": "qx.proto",
  "reflection": false,
  "auth": "All RPCs require gRPC metadata `authorization: Bearer <token>` (keyx API key with admin|owner role, or a configured local token). Missing/invalid \u2192 UNAUTHENTICATED.",
  "stages": {
    "local-dev": "localhost:50051",
    "integration": "grpc.integration.qx.vexarr.com:443",
    "staging": "grpc.staging.qx.vexarr.com:443",
    "production": "grpc.qx.vexarr.com:443"
  },
  "rpc_count": 34,
  "groups": [
    {
      "name": "Topics & Messaging",
      "rpcs": [
        {
          "method": "OpenTopic",
          "fullMethod": "qx.v1.Broker/OpenTopic",
          "type": "unary",
          "description": "Create/open a topic with N partitions (idempotent).",
          "metadata": [
            {
              "key": "authorization",
              "value": "Bearer {{qx_token}}"
            }
          ],
          "message": {
            "name": "orders",
            "partition_count": 6
          },
          "responseSummary": "OpenTopicResponse { partition_count }"
        },
        {
          "method": "Send",
          "fullMethod": "qx.v1.Broker/Send",
          "type": "unary",
          "description": "Append one record. `key`/`payload` are base64-encoded bytes.",
          "metadata": [
            {
              "key": "authorization",
              "value": "Bearer {{qx_token}}"
            }
          ],
          "message": {
            "topic": "orders",
            "key": "dXNlci00Mg==",
            "payload": "eyJvcmRlcl9pZCI6IDEwMDEsICJhbW91bnQiOiA0OTk5fQ=="
          },
          "responseSummary": "SendResponse { partition, record_id }"
        },
        {
          "method": "SendBatch",
          "fullMethod": "qx.v1.Broker/SendBatch",
          "type": "unary",
          "description": "Append many records in one round-trip.",
          "metadata": [
            {
              "key": "authorization",
              "value": "Bearer {{qx_token}}"
            }
          ],
          "message": {
            "topic": "orders",
            "items": [
              {
                "key": "dXNlci00Mg==",
                "payload": "eyJvcmRlcl9pZCI6IDEwMDEsICJhbW91bnQiOiA0OTk5fQ=="
              },
              {
                "key": "dXNlci00Mw==",
                "payload": "eyJvcmRlcl9pZCI6MTAwMn0="
              }
            ]
          },
          "responseSummary": "SendBatchResponse { results[] }"
        },
        {
          "method": "Receive",
          "fullMethod": "qx.v1.Broker/Receive",
          "type": "unary",
          "description": "Pull up to `max` messages (lease/visibility semantics).",
          "metadata": [
            {
              "key": "authorization",
              "value": "Bearer {{qx_token}}"
            }
          ],
          "message": {
            "topic": "orders",
            "max": 10
          },
          "responseSummary": "ReceiveResponse { messages[] }"
        },
        {
          "method": "ReceiveStream",
          "fullMethod": "qx.v1.Broker/ReceiveStream",
          "type": "server-stream",
          "description": "SERVER-STREAMING: long-poll a continuous stream of messages. In Postman click Invoke and watch the stream pane; Ctrl-C to stop in grpcurl.",
          "metadata": [
            {
              "key": "authorization",
              "value": "Bearer {{qx_token}}"
            }
          ],
          "message": {
            "topic": "orders",
            "max_batch": 50,
            "poll_interval_ms": 250
          },
          "responseSummary": "stream TopicMessage"
        },
        {
          "method": "Ack",
          "fullMethod": "qx.v1.Broker/Ack",
          "type": "unary",
          "description": "Acknowledge a message by its receipt (removes from inflight).",
          "metadata": [
            {
              "key": "authorization",
              "value": "Bearer {{qx_token}}"
            }
          ],
          "message": {
            "topic": "orders",
            "receipt": {
              "partition": 0,
              "record_id": 1,
              "attempt": 1
            }
          },
          "responseSummary": "AckResponse {}"
        },
        {
          "method": "Nack",
          "fullMethod": "qx.v1.Broker/Nack",
          "type": "unary",
          "description": "Negative-ack: requeue the message for redelivery.",
          "metadata": [
            {
              "key": "authorization",
              "value": "Bearer {{qx_token}}"
            }
          ],
          "message": {
            "topic": "orders",
            "receipt": {
              "partition": 0,
              "record_id": 1,
              "attempt": 1
            }
          },
          "responseSummary": "NackResponse {}"
        },
        {
          "method": "ExtendVisibility",
          "fullMethod": "qx.v1.Broker/ExtendVisibility",
          "type": "unary",
          "description": "Extend the visibility timeout of an inflight message.",
          "metadata": [
            {
              "key": "authorization",
              "value": "Bearer {{qx_token}}"
            }
          ],
          "message": {
            "topic": "orders",
            "receipt": {
              "partition": 0,
              "record_id": 1,
              "attempt": 1
            },
            "extension_ms": 30000
          },
          "responseSummary": "ExtendVisibilityResponse {}"
        },
        {
          "method": "Stats",
          "fullMethod": "qx.v1.Broker/Stats",
          "type": "unary",
          "description": "Per-topic queue depths.",
          "metadata": [
            {
              "key": "authorization",
              "value": "Bearer {{qx_token}}"
            }
          ],
          "message": {
            "topic": "orders"
          },
          "responseSummary": "StatsResponse { partition_count, pending, inflight, dead }"
        }
      ]
    },
    {
      "name": "Consumer Groups",
      "rpcs": [
        {
          "method": "StreamFromGroup",
          "fullMethod": "qx.v1.Broker/StreamFromGroup",
          "type": "unary",
          "description": "Read from a partition starting at the group's committed offset.",
          "metadata": [
            {
              "key": "authorization",
              "value": "Bearer {{qx_token}}"
            }
          ],
          "message": {
            "topic": "orders",
            "group": "billing-workers",
            "partition": 0,
            "max": 100
          },
          "responseSummary": "StreamFromGroupResponse { messages[] }"
        },
        {
          "method": "CommitGroupOffset",
          "fullMethod": "qx.v1.Broker/CommitGroupOffset",
          "type": "unary",
          "description": "Commit a consumed offset for (group, partition).",
          "metadata": [
            {
              "key": "authorization",
              "value": "Bearer {{qx_token}}"
            }
          ],
          "message": {
            "topic": "orders",
            "group": "billing-workers",
            "partition": 0,
            "offset": 42
          },
          "responseSummary": "CommitGroupOffsetResponse {}"
        },
        {
          "method": "GetGroupOffset",
          "fullMethod": "qx.v1.Broker/GetGroupOffset",
          "type": "unary",
          "description": "Read the committed offset for (group, partition).",
          "metadata": [
            {
              "key": "authorization",
              "value": "Bearer {{qx_token}}"
            }
          ],
          "message": {
            "topic": "orders",
            "group": "billing-workers",
            "partition": 0
          },
          "responseSummary": "GetGroupOffsetResponse { offset? }"
        }
      ]
    },
    {
      "name": "Group Coordinator",
      "rpcs": [
        {
          "method": "JoinGroup",
          "fullMethod": "qx.v1.Broker/JoinGroup",
          "type": "unary",
          "description": "Join a rebalanceable group; returns your member id + partition assignment.",
          "metadata": [
            {
              "key": "authorization",
              "value": "Bearer {{qx_token}}"
            }
          ],
          "message": {
            "topic": "orders",
            "group": "billing-workers"
          },
          "responseSummary": "JoinGroupResponse { member_id, generation, assignment[] }"
        },
        {
          "method": "Heartbeat",
          "fullMethod": "qx.v1.Broker/Heartbeat",
          "type": "unary",
          "description": "Keep membership alive; surfaces rebalances via a new generation.",
          "metadata": [
            {
              "key": "authorization",
              "value": "Bearer {{qx_token}}"
            }
          ],
          "message": {
            "topic": "orders",
            "group": "billing-workers",
            "member_id": 1
          },
          "responseSummary": "HeartbeatResponse { generation, assignment[] }"
        },
        {
          "method": "LeaveGroup",
          "fullMethod": "qx.v1.Broker/LeaveGroup",
          "type": "unary",
          "description": "Leave the group (triggers a rebalance).",
          "metadata": [
            {
              "key": "authorization",
              "value": "Bearer {{qx_token}}"
            }
          ],
          "message": {
            "topic": "orders",
            "group": "billing-workers",
            "member_id": 1
          },
          "responseSummary": "LeaveGroupResponse {}"
        },
        {
          "method": "StreamForMember",
          "fullMethod": "qx.v1.Broker/StreamForMember",
          "type": "unary",
          "description": "Read records for this member's assigned partitions.",
          "metadata": [
            {
              "key": "authorization",
              "value": "Bearer {{qx_token}}"
            }
          ],
          "message": {
            "topic": "orders",
            "group": "billing-workers",
            "member_id": 1,
            "max": 100
          },
          "responseSummary": "StreamFromGroupResponse { messages[] }"
        }
      ]
    },
    {
      "name": "Workflow Tasks",
      "rpcs": [
        {
          "method": "CreateRootTask",
          "fullMethod": "qx.v1.Broker/CreateRootTask",
          "type": "unary",
          "description": "Start a workflow DAG with a root task.",
