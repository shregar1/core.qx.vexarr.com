        {
          "method": "ListChildren",
          "fullMethod": "qx.v1.Broker/ListChildren",
          "type": "unary",
          "description": "List child task ids of a parent.",
          "metadata": [
            {
              "key": "authorization",
              "value": "Bearer {{qx_token}}"
            }
          ],
          "message": {
            "workflow": "order-fulfillment",
            "parent_id": 1
          },
          "responseSummary": "ListChildrenResponse { child_ids[] }"
        },
        {
          "method": "MarkTaskRunning",
          "fullMethod": "qx.v1.Broker/MarkTaskRunning",
          "type": "unary",
          "description": "Transition a task to Running.",
          "metadata": [
            {
              "key": "authorization",
              "value": "Bearer {{qx_token}}"
            }
          ],
          "message": {
            "workflow": "order-fulfillment",
            "task_id": 1
          },
          "responseSummary": "TaskOpResponse {}"
        },
        {
          "method": "CompleteTask",
          "fullMethod": "qx.v1.Broker/CompleteTask",
          "type": "unary",
          "description": "Mark a task Done with a result payload (base64 bytes).",
          "metadata": [
            {
              "key": "authorization",
              "value": "Bearer {{qx_token}}"
            }
          ],
          "message": {
            "workflow": "order-fulfillment",
            "task_id": 1,
            "result": "eyJzdGF0dXMiOiAib2siLCAic2hpcHBlZCI6IHRydWV9"
          },
          "responseSummary": "TaskOpResponse {}"
        },
        {
          "method": "FailTask",
          "fullMethod": "qx.v1.Broker/FailTask",
          "type": "unary",
          "description": "Mark a task Failed with an error string.",
          "metadata": [
            {
              "key": "authorization",
              "value": "Bearer {{qx_token}}"
            }
          ],
          "message": {
            "workflow": "order-fulfillment",
            "task_id": 1,
            "error": "payment declined"
          },
          "responseSummary": "TaskOpResponse {}"
        },
        {
          "method": "CancelTask",
          "fullMethod": "qx.v1.Broker/CancelTask",
          "type": "unary",
          "description": "Cancel a task (and its subtree).",
          "metadata": [
            {
              "key": "authorization",
              "value": "Bearer {{qx_token}}"
            }
          ],
          "message": {
            "workflow": "order-fulfillment",
            "task_id": 1
          },
          "responseSummary": "CancelTaskResponse { cancelled }"
        },
        {
          "method": "CompleteTaskWithEmits",
          "fullMethod": "qx.v1.Broker/CompleteTaskWithEmits",
          "type": "unary",
          "description": "Complete a task and atomically stage topic emits (transactional outbox).",
          "metadata": [
            {
              "key": "authorization",
              "value": "Bearer {{qx_token}}"
            }
          ],
          "message": {
            "workflow": "order-fulfillment",
            "task_id": 1,
            "result": "eyJzdGF0dXMiOiAib2siLCAic2hpcHBlZCI6IHRydWV9",
            "emits": [
              {
                "topic": "shipments",
                "payload": "eyJvcmRlcl9pZCI6MTAwMX0="
              }
            ]
          },
          "responseSummary": "TaskOpResponse {}"
        }
      ]
    },
