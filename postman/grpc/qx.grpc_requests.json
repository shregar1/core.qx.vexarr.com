              "key": "authorization",
              "value": "Bearer {{qx_token}}"
            }
          ],
          "message": {
            "workflow": "order-fulfillment",
            "parent_id": 1,
            "payload": "eyJzdGVwIjoicmVzZXJ2ZS1pbnZlbnRvcnkifQ=="
          },
          "responseSummary": "CreateTaskResponse { task_id }"
        },
        {
          "method": "GetTask",
          "fullMethod": "qx.v1.Broker/GetTask",
          "type": "unary",
          "description": "Fetch a task (status: 0=Pending 1=Running 2=Done 3=Failed 4=Cancelled).",
